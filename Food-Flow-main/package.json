{
  "name": "foodflow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "ingest:weather": "node scripts/ingest-weather.mjs",
    "ingest:market": "node scripts/ingest-market.mjs",
    "ml:train": "python ml/train.py",
    "ml:train:price": "python ml/train_price.py",
    "ml:export:prices": "python ml/export_prices.py"
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "framer-motion": "11.11.17",
    "leaflet": "^1.9.4",
    "lucide-react": "0.456.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "6.28.0",
    "recharts": "2.13.3"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/node": "^22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "autoprefixer": "10.4.20",
    "playwright": "^1.49.0",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.15",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "^2.1.8"
  }
}
